# Copy to .env (gitignored), or point LLM_TUI_ENV at another file.
# Token: LM Studio → Developer → Manage Tokens (sk-lm-…).
# Leave unset if Server Settings → Require authentication is off.
# Dummy `lm-studio` is rejected (lmstudio-auth-error).

# LM_API_TOKEN=
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_MODEL=local-model
# LLM_TUI_BACKEND=lmstudio
# LLM_TUI_ROOT=
